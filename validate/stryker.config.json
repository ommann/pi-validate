{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "cd client && NG_BUILD_TYPE_CHECK=0 node node_modules/@angular/cli/bin/ng.js test --watch=false --coverage=false"
  },
  "coverageAnalysis": "off",
  "tempDirName": ".state/stryker",
  "mutate": [
    "client/src/**/*.ts",
    "!client/src/**/*.{spec,d}.ts"
  ],
  "ignorers": ["angular"],
  "reporters": ["progress", "clear-text", "html"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "ignorePatterns": [
    "client/.angular/**",
    "client/dist/**",
    "client/coverage/**",
    ".state/**",
    ".validate-coverage-*/**",
    "client/.validate-coverage-*/**"
  ]
}
