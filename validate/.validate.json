{
  "groups": [
    [
      "build"
    ],
    [
      "test",
      "lint"
    ],
    [
      "typescript-empty-lines"
    ],
    [
      "never-applicable"
    ],
    [
      "ast-grep-no-subscribe",
      "ast-grep-no-clear-interval",
      "ast-grep-no-discarded-router-navigation",
      "ast-grep-no-sanitization-bypass",
      "eslint-rare"
    ],
    [
      "ast-grep-no-dynamic-code"
    ]
  ],
  "policies": {
    "ast-grep-no-clear-interval": "user",
    "ast-grep-no-discarded-router-navigation": "user",
    "ast-grep-no-dynamic-code": "user",
    "ast-grep-no-sanitization-bypass": "user",
    "ast-grep-no-subscribe": "user",
    "build": "agent",
    "eslint-rare": "agent",
    "lint": "agent",
    "never-applicable": "agent",
    "test": "agent",
    "typescript-empty-lines": "agent"
  },
  "removed": [],
  "useNix": true,
  "configs": {
    "typescript-empty-lines": {
      "minEmptyLineRatio": 0.13
    }
  }
}
