{
  "groups": [
    [
      "build"
    ],
    [
      "lint",
      "test"
    ],
    [
      "typescript-empty-lines",
      "no-discarded-router-navigation",
      "no-clear-interval"
    ]
  ],
  "policies": {
    "build": "agent",
    "lint": "agent",
    "no-clear-interval": "agent",
    "no-discarded-router-navigation": "agent",
    "test": "agent",
    "typescript-empty-lines": "agent"
  },
  "removed": [],
  "useNix": true,
  "configs": {
    "typescript-empty-lines": {
      "minEmptyLineRatio": 0.1
    }
  }
}
